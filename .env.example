# Images proches de la prod observee dans le dump du 2026-09-05.
# Le dump indique WordPress 6.9.7. Le tag patch exact
# wordpress:6.9.7-php8.3-apache n'etait pas disponible lors de la validation,
# donc on utilise la ligne officielle 6.9 avec PHP 8.3.
WORDPRESS_IMAGE=${WORDPRESS_IMAGE}
WORDPRESS_CLI_IMAGE=${WORDPRESS_CLI_IMAGE}
MARIADB_IMAGE=${MARIADB_IMAGE}
WP_CLI_CACHE_DIR=/tmp/wp-cli-cache

# Backups de prod existants. Utiliser un chemin absolu, pas "~".
LOCAL_BACKUP_DIR=${LOCAL_BACKUP_DIR}
DB_BACKUP_FILE=${DB_BACKUP_FILE}
UPLOADS_BACKUP_FILE=${UPLOADS_BACKUP_FILE}

# Base locale uniquement.
WORDPRESS_DB_NAME=bitnami_wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
MARIADB_ROOT_PASSWORD=root
WORDPRESS_DEBUG=1

# URLs locales. kabowd.localhost pointe normalement vers 127.0.0.1.
WORDPRESS_PORT=8080
WP_LOCAL_URL=http://kabowd.localhost:8080
WP_LOCAL_HOST=kabowd.localhost:8080
WP_PROD_HOST=kabowd.ca

# Outils locaux.
DB_PORT=3307
ADMINER_PORT=8081
MAILPIT_PORT=8025

# Theme parent requis par le theme enfant.
LOCAL_PARENT_THEME=biz-flick
LOCAL_CHILD_THEME=kb-biz-flick-child
LOCAL_ACTIVATE_CHILD_THEME=true

# Version WordPress cible detectee dans le dump.
LOCAL_WORDPRESS_VERSION=6.9.7
LOCAL_WORDPRESS_LOCALE=fr_CA

# Plugins detectes dans la prod multisite.
LOCAL_INSTALL_PROD_PLUGINS=true
LOCAL_PROD_PLUGINS=jetpack the-post-grid ultimate-addons-for-gutenberg smtp-amazon-ses w3-total-cache wordpress-importer

# Garde-fous locaux.
LOCAL_DISABLE_WP_CRON=true
LOCAL_BLOCK_EXTERNAL_HTTP=false
LOCAL_SMTP_HOST=mailpit
LOCAL_SMTP_PORT=1025
